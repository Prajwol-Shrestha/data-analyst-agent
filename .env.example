# Supabase > Connect > Transaction pooler (port 6543). Server only, never NEXT_PUBLIC_.
# Admin: creates schemas/tables when loading CSVs.
DATABASE_URL_ADMIN=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Read-only role the agent's SQL runs as. Same host, user is <role>.<project-ref>.
DATABASE_URL_READONLY=postgresql://analyst_ro.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
